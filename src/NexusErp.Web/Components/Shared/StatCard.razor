@*
    Ana KPI hücresi: kicker → rakam → ipucu satırı (+ opsiyonel sparkline).
    Mevcut parametre adları korundu; çağıran sayfaların değişmesi gerekmiyor.
*@
<Blueprint Class="bp-pad" Style="height:100%">
    <div style="display:flex;align-items:flex-start;gap:10px">
        <div style="min-width:0;flex:1">
            <div class="kpi-kicker">@Title</div>
            <div class="kpi-value" style="margin-top:4px">
                @if (!string.IsNullOrEmpty(Suffix))
                {
                    <span class="cur">@Suffix</span>
                }
                @Value
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <MudIcon Icon="@Icon" Style="width:17px;height:17px;opacity:.45" />
        }
    </div>

    <div style="display:flex;align-items:flex-end;gap:10px;margin-top:6px">
        <div class="kpi-hint" style="flex:1;min-width:0">
            @if (Delta is { } d)
            {
                <span style="color:var(--color-accent-700);font-weight:600">
                    @(d >= 0 ? "▲" : "▼") %@Math.Abs(d).ToString("N1")
                </span>
                <span> · </span>
            }
            @Hint
        </div>

        @if (Sparkline is { Count: > 1 })
        {
            <svg width="74" height="22" viewBox="0 0 74 22" style="flex:none;overflow:visible">
                <polyline points="@SparkPoints()" fill="none"
                          stroke="var(--color-accent)" stroke-width="1.5"
                          stroke-linejoin="round" stroke-linecap="round" />
            </svg>
        }
    </div>
</Blueprint>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter, EditorRequired] public string Value { get; set; } = default!;
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Icon { get; set; }

    /// <summary>Geçen döneme göre yüzde değişim. Null ise gösterilmez.</summary>
    [Parameter] public decimal? Delta { get; set; }

    /// <summary>74×22 sparkline için ham değerler. En az 2 nokta gerekir.</summary>
    [Parameter] public IReadOnlyList<decimal>? Sparkline { get; set; }

    /// <summary>
    /// Eski çağrılarla uyum için tutuluyor. Yeni tasarım tek aksan kullanıyor,
    /// renk ayrımı yapmıyor. ⚠️ Kaldırılırsa parametreyi geçen sayfalar ÇALIŞMA
    /// ZAMANINDA patlar — Blazor parametre eşleşmesini derlemede denetlemez.
    /// </summary>
    [Parameter] public Color Color { get; set; } = Color.Default;

    private string SparkPoints()
    {
        var v = Sparkline!;
        var min = v.Min();
        var max = v.Max();
        var span = max - min;

        // Düz çizgi (tüm değerler eşit) → ortada yatay çizgi
        var pts = new string[v.Count];
        for (var i = 0; i < v.Count; i++)
        {
            var x = v.Count == 1 ? 0m : 74m * i / (v.Count - 1);
            var y = span == 0m ? 11m : 20m - 18m * (v[i] - min) / span;
            pts[i] = string.Create(System.Globalization.CultureInfo.InvariantCulture,
                                   $"{x:0.##},{y:0.##}");
        }
        return string.Join(' ', pts);
    }
}
