@* Dashboard'daki küçük istatistik kutusu. *@
<MudPaper Elevation="0" Class="pa-3" Style="height:100%;border:1px solid var(--mud-palette-lines-default)">
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
        <MudIcon Icon="@Icon" Color="@Color" Size="Size.Small" />
        <div>
            <MudText Typo="Typo.caption">@Label</MudText>
            <MudText Typo="Typo.subtitle2" Style="font-weight:600">@Value</MudText>
        </div>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public string Value { get; set; } = default!;
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Analytics;
    [Parameter] public Color Color { get; set; } = Color.Primary;
}
