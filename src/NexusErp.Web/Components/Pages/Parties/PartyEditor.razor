@using NexusErp.Application.Parties
@using NexusErp.Domain.Enums
@using NexusErp.Domain.ValueObjects
@inject PartyService PartyService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_form is null)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" Class="my-4" />
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_form.Code" Label="Cari Kodu *"
                                  Variant="Variant.Outlined" MaxLength="30" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_form.Title" Label="Ticari Unvan *"
                                  Variant="Variant.Outlined" MaxLength="300" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="PartyType" @bind-Value="_form.Type" Label="Cari Tipi"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@PartyType.Customer">Müşteri</MudSelectItem>
                        <MudSelectItem Value="@PartyType.Supplier">Tedarikçi</MudSelectItem>
                        <MudSelectItem Value="@PartyType.Both">Müşteri + Tedarikçi</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @* Doğrulama AYNI domain kodunu çağırıyor (TaxIdentifier.TryParse) —
                       kural tek yerde tanımlı, iki yerde kullanılıyor. *@
                    <MudTextField @bind-Value="_form.TaxNumber" Label="VKN / TCKN"
                                  Variant="Variant.Outlined" MaxLength="11" Margin="Margin.Dense"
                                  Validation="@(new Func<string?, string?>(ValidateTaxNumber))"
                                  HelperText="VKN 10, TCKN 11 hane" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_form.TaxOffice" Label="Vergi Dairesi"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_form.ContactName" Label="Yetkili Kişi"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_form.Email" Label="E-posta"
                                  Variant="Variant.Outlined" InputType="InputType.Email"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_form.Phone" Label="Telefon"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_form.Address" Label="Adres"
                                  Variant="Variant.Outlined" Lines="2" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_form.District" Label="İlçe"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_form.City" Label="İl"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_form.PaymentTermDays" Label="Ödeme Vadesi (gün)"
                                     Variant="Variant.Outlined" Min="0" Max="365" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_form.CreditLimit" Label="Kredi Limiti"
                                     Variant="Variant.Outlined" Format="N2" Min="0m"
                                     Margin="Margin.Dense" HelperText="0 = limitsiz" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_form.Currency" Label="Para Birimi"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("TRY")">TRY</MudSelectItem>
                        <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                        <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_form.Notes" Label="Notlar"
                                  Variant="Variant.Outlined" Lines="2" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_form.IsActive" Color="Color.Success" Label="Aktif" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Vazgeç</MudButton>
        @* _saving: kullanıcı iki kez basarsa iki kayıt oluşur — en basit çift gönderim koruması *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || _form is null)" OnClick="SaveAsync">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
            }
            Kaydet
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Guid? PartyId { get; set; }

    private PartyForm? _form;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (PartyId is null)
        {
            _form = new PartyForm();
            _form.Code = await PartyService.SuggestCodeAsync(_form.Type);
        }
        else
        {
            _form = await PartyService.GetFormAsync(PartyId.Value);
        }
    }

    private static string? ValidateTaxNumber(string? value)
        => string.IsNullOrWhiteSpace(value) || TaxIdentifier.TryParse(value, out _)
            ? null
            : "Kontrol basamağı hatalı — VKN/TCKN geçersiz.";

    private async Task SaveAsync()
    {
        if (_form is null) return;

        _saving = true;
        var ok = await Snackbar.RunAsync(
            async () => await PartyService.SaveAsync(_form),
            "Cari kart kaydedildi.");
        _saving = false;

        if (ok) Dialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => Dialog.Cancel();
}
