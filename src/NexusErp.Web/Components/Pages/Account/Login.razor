@page "/giris"
@layout NexusErp.Web.Components.Layout.EmptyLayout
@using NexusErp.Infrastructure.Identity
@attribute [AllowAnonymous]

<PageTitle>Giriş · NexusERP</PageTitle>

@*
    Tasarım sistemine uygun giriş ekranı: köşesiz, blueprint çerçeve, tek aksan.
    Ham hex yok — her değer theme.css'teki değişkenden okunuyor, böylece koyu
    tema burada da çalışıyor.
*@
<div class="nx-login">
    <div class="nx-login-brand">
        <span class="nx-login-mark">NEXUSERP</span>
        <span class="nx-login-tagline">Ön Muhasebe &amp; Abonelik Yönetimi</span>
    </div>

    <Blueprint Class="bp-pad" Style="width:100%;max-width:380px;background:var(--color-bg)">
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="nx-login-error" role="alert">@Error</div>
        }

        @* ⚠️ Düz HTML form + POST. Blazor'ın interaktif devresinde HttpContext yok;
           cookie yazmak için isteğin sunucuya normal bir POST olarak gitmesi gerekiyor. *@
        <form method="post" action="/hesap/giris">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="field" style="margin-bottom:12px">
                <label for="email">E-posta</label>
                <input id="email" name="email" type="email" required autofocus
                       class="input" placeholder="admin@nexusdemo.com.tr" />
            </div>

            <div class="field" style="margin-bottom:18px">
                <label for="password">Parola</label>
                <input id="password" name="password" type="password" required class="input" />
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%">
                GİRİŞ YAP
            </button>
        </form>

        <div class="nx-login-divider"></div>

        <div class="kpi-kicker" style="margin-bottom:8px">
            Demo hesapları · parola <span class="mono">@IdentitySeeder.DemoPassword</span>
        </div>

        <table class="table">
            <tbody>
                @foreach (var (email, role) in DemoAccounts)
                {
                    <tr>
                        <td class="mono" style="font-size:11.5px">@email</td>
                        <td style="text-align:right"><StatusTag Text="@role" Variant="neutral" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </Blueprint>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private static readonly (string Email, string Role)[] DemoAccounts =
    [
        ("admin@nexusdemo.com.tr", "Admin"),
        ("muhasebe@nexusdemo.com.tr", "Muhasebe"),
        ("satis@nexusdemo.com.tr", "Satış"),
        ("bakis@nexusdemo.com.tr", "Görüntüleyici"),
    ];
}
