@page "/kullanicilar"
@attribute [Authorize(Roles = "Admin")]
@using NexusErp.Infrastructure.Identity
@inject UserAdminService Users
@inject ISnackbar Snackbar

@*
    Kullanıcı yönetimi — YALNIZCA Admin.

    ⚠️ Bu dosya neden "Pages/System" yerine "Pages/Administration" altında:
    klasör adı namespace'e dönüşüyor ve NexusErp.Web.Components.Pages.System
    namespace'i TÜM projede global "System" namespace'ini gölgeliyor —
    System.Net, System.Globalization gibi her using birden çözümlenemez hale
    geliyor. Derleyici hatayı ilgisiz dosyalarda gösterdiği için bulması zor.

    ⚠️ [Authorize(Roles = "Admin")] tek başına yetmez, sunucu tarafındaki
    UserAdminService de her sorguda TenantId filtresi uyguluyor. Sayfa yetkisi
    "bu ekranı kim görür"ü, servis filtresi "hangi veriyi görür"ü çözer;
    ikisi ayrı sorumluluk ve ikisi de gerekli.

    Razor tuzakları (SubscriptionDetailPage'deki notların aynısı):
    karmaşık ifadeler @code bloğundaki yardımcı özelliklere alındı.
*@

<PageTitle>Kullanıcılar · NexusERP</PageTitle>

<PageHeader Kicker="SİSTEM" Title="Kullanıcılar"
            Description="Erişim yetkileri, rol atamaları ve hesap durumu">
    <Actions>
        <button class="btn btn-primary btn-sm" @onclick="ToggleCreate">
            @CreateButtonText
        </button>
    </Actions>
</PageHeader>

<div class="stack">

    @if (_generatedPassword is not null)
    {
        @* ⚠️ Parola SADECE burada, bir kez görünür. Hiçbir yerde saklanmıyor;
           sayfa yenilenirse bir daha gösterilemez, sıfırlamak gerekir. *@
        <Blueprint Class="bp-pad">
            <h5 style="margin-bottom:6px">@PasswordPanelTitle</h5>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <code style="font-size:18px;letter-spacing:.08em;padding:6px 12px;
                             background:var(--color-neutral-100)">@_generatedPassword</code>
                <button class="btn btn-secondary btn-sm" @onclick="DismissPassword">
                    Not aldım, kapat
                </button>
            </div>
            <div class="kpi-hint" style="margin-top:8px">
                Bu parola veri tabanında düz metin olarak TUTULMUYOR — yalnızca özeti
                saklanıyor. Kullanıcıya iletmeden bu paneli kapatmayın.
            </div>
        </Blueprint>
    }

    @if (_showCreate)
    {
        <Blueprint Class="bp-pad">
            <h5 style="margin-bottom:10px">Yeni Kullanıcı</h5>

            <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
                <div class="field" style="min-width:240px;flex:1">
                    <label>E-posta</label>
                    <input class="input" type="email" @bind="_newEmail"
                           placeholder="ad.soyad@firma.com.tr" />
                </div>
                <div class="field" style="min-width:200px;flex:1">
                    <label>Ad Soyad</label>
                    <input class="input" @bind="_newFullName" />
                </div>
                <div class="field" style="width:190px">
                    <label>Rol</label>
                    <select class="input" @bind="_newRole">
                        @foreach (var role in AppRoles.All)
                        {
                            <option value="@role">@RoleText(role)</option>
                        }
                    </select>
                </div>
                <button class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync">
                    Oluştur
                </button>
            </div>

            <div class="kpi-hint" style="margin-top:8px">
                Parola otomatik üretilir ve oluşturduktan sonra bir kez gösterilir.
            </div>
        </Blueprint>
    }

    <Blueprint Class="bp-pad">
        @if (_loading)
        {
            <div class="text-muted">Yükleniyor…</div>
        }
        else
        {
            <div class="scroll-x">
                <table class="table" style="min-width:820px">
                    <thead>
                        <tr>
                            <th>Ad Soyad</th><th>E-posta</th><th>Rol</th>
                            <th>Son giriş</th><th>Durum</th><th class="num">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in _users)
                        {
                            <tr>
                                <td>@u.FullName</td>
                                <td>@u.Email</td>
                                <td>
                                    <select class="input" style="min-width:150px"
                                            value="@CurrentRole(u)"
                                            @onchange="@(e => ChangeRoleAsync(u, e))">
                                        @foreach (var role in AppRoles.All)
                                        {
                                            <option value="@role">@RoleText(role)</option>
                                        }
                                    </select>
                                </td>
                                <td>@u.LastLoginText</td>
                                <td>
                                    <StatusTag Text="@StatusText(u)" Variant="@StatusVariant(u)" />
                                </td>
                                <td class="num">
                                    @if (u.IsLockedOut)
                                    {
                                        <button class="btn btn-ghost btn-sm" disabled="@_busy"
                                                @onclick="@(() => UnlockAsync(u))">
                                            Kilidi Aç
                                        </button>
                                    }
                                    <button class="btn btn-ghost btn-sm" disabled="@_busy"
                                            @onclick="@(() => ResetPasswordAsync(u))">
                                        Parola Sıfırla
                                    </button>
                                    <button class="btn btn-ghost btn-sm" disabled="@_busy"
                                            @onclick="@(() => ToggleActiveAsync(u))">
                                        @ActiveButtonText(u)
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="kpi-hint" style="margin-top:10px">
                Kullanıcılar SİLİNMEZ, pasifleştirilir: denetim kayıtları ve
                belgelerdeki "oluşturan / değiştiren" bilgisi onlara atıfta bulunuyor.
            </div>
        }
    </Blueprint>

    <Blueprint Class="bp-pad">
        <h5 style="margin-bottom:10px">Roller ve Yetkiler</h5>
        <div class="scroll-x">
            <table class="table" style="min-width:620px">
                <thead>
                    <tr><th>Rol</th><th>Yapabildikleri</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Yönetici</td>
                        <td>Her şey · kullanıcı ve yetki yönetimi</td>
                    </tr>
                    <tr>
                        <td>Muhasebe</td>
                        <td>Fatura kesme, tahsilat işleme, abonelik faturalandırma, raporlar</td>
                    </tr>
                    <tr>
                        <td>Satış</td>
                        <td>Cari ve fatura oluşturma · tahsilat işleyemez</td>
                    </tr>
                    <tr>
                        <td>Görüntüleyici</td>
                        <td>Salt okuma · hiçbir kayıt değiştiremez</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </Blueprint>
</div>

@code {
    private IReadOnlyList<AppUserListItem> _users = [];
    private bool _loading = true;
    private bool _busy;

    private bool _showCreate;
    private string _newEmail = string.Empty;
    private string _newFullName = string.Empty;
    private string _newRole = AppRoles.Muhasebe;

    private string? _generatedPassword;
    private string? _passwordOwner;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _users = await Users.ListAsync();
        _loading = false;
    }

    // ---------------- Görünüm yardımcıları ----------------

    private string CreateButtonText => _showCreate ? "Vazgeç" : "Yeni Kullanıcı";

    private string PasswordPanelTitle => $"{_passwordOwner} için parola";

    private static string CurrentRole(AppUserListItem u) =>
        u.Roles.Count > 0 ? u.Roles[0] : AppRoles.Goruntuleyici;

    private static string RoleText(string role) => role switch
    {
        AppRoles.Admin => "Yönetici",
        AppRoles.Muhasebe => "Muhasebe",
        AppRoles.Satis => "Satış",
        AppRoles.Goruntuleyici => "Görüntüleyici",
        _ => role
    };

    private static string StatusText(AppUserListItem u)
    {
        if (!u.IsActive) return "Pasif";
        return u.IsLockedOut ? "Kilitli" : "Aktif";
    }

    private static string StatusVariant(AppUserListItem u)
    {
        if (!u.IsActive) return "neutral";
        return u.IsLockedOut ? "outline" : "accent-2";
    }

    private static string ActiveButtonText(AppUserListItem u) =>
        u.IsActive ? "Pasifleştir" : "Aktifleştir";

    // ---------------- İşlemler ----------------

    private void ToggleCreate()
    {
        _showCreate = !_showCreate;
        if (!_showCreate) ResetForm();
    }

    private void ResetForm()
    {
        _newEmail = string.Empty;
        _newFullName = string.Empty;
        _newRole = AppRoles.Muhasebe;
    }

    private void DismissPassword()
    {
        _generatedPassword = null;
        _passwordOwner = null;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        string? password = null;

        var ok = await Snackbar.RunAsync(async () =>
            password = await Users.CreateAsync(
                new CreateUserRequest(_newEmail, _newFullName, _newRole)));
        _busy = false;

        if (!ok) return;

        _generatedPassword = password;
        _passwordOwner = _newFullName;
        _showCreate = false;
        ResetForm();

        Snackbar.Add("Kullanıcı oluşturuldu.", Severity.Success);
        await LoadAsync();
    }

    private async Task ChangeRoleAsync(AppUserListItem user, ChangeEventArgs e)
    {
        var role = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(role)) return;

        _busy = true;
        var ok = await Snackbar.RunAsync(
            () => Users.ChangeRoleAsync(user.Id, role),
            $"{user.FullName} → {RoleText(role)}");
        _busy = false;

        // Hata durumunda da yeniden yüklüyoruz: reddedilen değişiklik select
        // kutusunda seçili kalmasın, kullanıcı olmayan bir durumu görmesin.
        await LoadAsync();
        if (!ok) StateHasChanged();
    }

    private async Task ToggleActiveAsync(AppUserListItem user)
    {
        _busy = true;
        var ok = await Snackbar.RunAsync(
            () => Users.SetActiveAsync(user.Id, !user.IsActive),
            user.IsActive ? "Kullanıcı pasifleştirildi." : "Kullanıcı aktifleştirildi.");
        _busy = false;

        if (ok) await LoadAsync();
    }

    private async Task UnlockAsync(AppUserListItem user)
    {
        _busy = true;
        var ok = await Snackbar.RunAsync(
            () => Users.UnlockAsync(user.Id), "Hesap kilidi açıldı.");
        _busy = false;

        if (ok) await LoadAsync();
    }

    private async Task ResetPasswordAsync(AppUserListItem user)
    {
        _busy = true;
        string? password = null;

        var ok = await Snackbar.RunAsync(
            async () => password = await Users.ResetPasswordAsync(user.Id));
        _busy = false;

        if (!ok) return;

        _generatedPassword = password;
        _passwordOwner = user.FullName;
        Snackbar.Add("Yeni parola üretildi.", Severity.Success);
    }
}
