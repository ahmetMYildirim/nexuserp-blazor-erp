@page "/hesap-plani"
@attribute [Authorize(Roles = "Admin,Muhasebe")]
@using NexusErp.Application.Accounting
@using NexusErp.Domain.Enums
@inject ChartOfAccountsService Accounts
@inject ISnackbar Snackbar

@*
    Tek Düzen Hesap Planı.

    ⚠️ Klasör adı "Accounting" — "System" gibi bir ad namespace'e dönüşüp global
    System namespace'ini gölgeliyor ve tüm projede using'ler çözümlenemez hale
    geliyor (bu depoda bir kez yaşandı, dosyalar Pages/Administration'a taşınmıştı).
*@

<PageTitle>Hesap Planı · NexusERP</PageTitle>

<PageHeader Kicker="MUHASEBE" Title="Hesap Planı"
            Description="Kayıtların yazıldığı hesaplar — Tek Düzen Hesap Planı">
    <Actions>
        <button class="btn btn-primary btn-sm" @onclick="@(() => _showCreate = !_showCreate)">
            @(_showCreate ? "Vazgeç" : "Alt Hesap Aç")
        </button>
    </Actions>
</PageHeader>

<div class="stack">


    @if (_showCreate)
    {
        <Blueprint Class="bp-pad">
            <h5 style="margin-bottom:10px">Yeni Alt Hesap</h5>

            <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
                <div class="field" style="width:180px">
                    <label>Hesap Kodu</label>
                    <input class="input" @bind="_newCode" placeholder="120.01" />
                </div>
                <div class="field" style="min-width:260px;flex:1">
                    <label>Hesap Adı</label>
                    <input class="input" @bind="_newName" placeholder="Yurtiçi Müşteriler" />
                </div>
                <button class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync">
                    Oluştur
                </button>
            </div>

            <div class="kpi-hint" style="margin-top:8px">
                Üst hesap koddan otomatik bulunur: <b>120.01</b> girerseniz <b>120</b>'nin
                altına açılır ve 120 ara hesaba dönüşerek doğrudan kayıt almayı bırakır.
                Türü de üst hesaptan devralır.
            </div>
        </Blueprint>
    }

    <Blueprint Class="bp-pad">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
            <div class="field" style="min-width:260px;flex:1">
                <label>Ara</label>
                <input class="input" @bind="_search" @bind:event="oninput"
                       placeholder="Kod veya hesap adı" />
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <label style="display:flex;align-items:center;gap:6px;font-weight:400">
                    <input type="checkbox" @bind="_onlyPostable" />
                    Yalnızca kayıt yazılabilenler
                </label>
            </div>
            <div class="kpi-hint" style="margin-left:auto">
                @Filtered.Count / @_accounts.Count hesap
            </div>
        </div>
    </Blueprint>

    <Blueprint Class="bp-table-pad" Scroll="true">
        @if (_loading)
        {
            <div class="text-muted" style="padding:10px">Yükleniyor…</div>
        }
        else
        {
            <table class="table" style="min-width:760px">
                <thead>
                    <tr>
                        <th style="width:120px">Kod</th>
                        <th>Hesap Adı</th>
                        <th style="width:150px">Tür</th>
                        <th style="width:150px">Kayıt Yazılır mı</th>
                        <th style="width:110px">Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Filtered)
                    {
                        <tr>
                            <td style="@Indent(a)">@a.Code</td>
                            <td style="@(a.IsPostable ? "" : "font-weight:600")">@a.Name</td>
                            <td><span class="kpi-hint">@a.Type.Text()</span></td>
                            <td>
                                @if (a.IsPostable)
                                {
                                    <StatusTag Text="Yazılabilir" Variant="accent-2" />
                                }
                                else
                                {
                                    <StatusTag Text="Ara hesap" Variant="neutral" />
                                }
                            </td>
                            <td>
                                @if (a.IsSystem)
                                {
                                    <StatusTag Text="Sistem" Variant="outline" />
                                }
                                else if (!a.IsActive)
                                {
                                    <StatusTag Text="Pasif" Variant="neutral" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </Blueprint>

    <Blueprint Class="bp-pad">
        <h5 style="margin:0 0 8px">Otomatik kayıtların kullandığı hesaplar</h5>
        <div class="kpi-hint" style="margin-bottom:10px">
            Fatura kestiğinizde ve tahsilat işlediğinizde muhasebe fişi kendiliğinden
            oluşur; hangi hesaba yazıldığı aşağıdaki gibidir. Bu hesaplar
            <b>Sistem</b> etiketlidir ve pasifleştirilemez.
        </div>
        <div class="scroll-x">
            <table class="table" style="min-width:680px">
                <thead>
                    <tr><th style="width:150px">İşlem</th><th>Oluşan kayıt</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Satış faturası</td>
                        <td>
                            <b>120 Alıcılar</b> borçlanır (müşteri size borçlandı) ·
                            <b>600 Yurtiçi Satışlar</b> ve <b>391 Hesaplanan KDV</b>
                            alacaklanır
                        </td>
                    </tr>
                    <tr>
                        <td>Alış faturası</td>
                        <td>
                            <b>153 Ticari Mallar</b> ve <b>191 İndirilecek KDV</b>
                            borçlanır · <b>320 Satıcılar</b> alacaklanır
                            (tedarikçiye borçlandınız)
                        </td>
                    </tr>
                    <tr>
                        <td>Tahsilat</td>
                        <td>
                            <b>100 Kasa</b> (nakit) veya <b>102 Bankalar</b> (havale/kart)
                            borçlanır · <b>120 Alıcılar</b> alacaklanır (alacak kapandı)
                        </td>
                    </tr>
                    <tr>
                        <td>Tahsilat iptali</td>
                        <td>Aynı kayıt <b>ters yönde</b> yazılır; orijinal fiş silinmez</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </Blueprint>
</div>

@code {
    private IReadOnlyList<AccountListItem> _accounts = [];
    private bool _loading = true;
    private bool _busy;
    private bool _showCreate;
    private bool _onlyPostable;
    private string _search = string.Empty;
    private string _newCode = string.Empty;
    private string _newName = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _accounts = await Accounts.ListAsync(includeInactive: true);
        _loading = false;
    }

    private List<AccountListItem> Filtered => _accounts
        .Where(a => !_onlyPostable || a.IsPostable)
        .Where(a => string.IsNullOrWhiteSpace(_search)
                    || a.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    /// <summary>Hiyerarşi girintisi kod uzunluğundan geliyor: 1 → 12 → 120.</summary>
    private static string Indent(AccountListItem item)
        => $"padding-left:{(item.Level - 1) * 14}px;font-variant-numeric:tabular-nums";

    private async Task CreateAsync()
    {
        _busy = true;
        var ok = await Snackbar.RunAsync(
            () => Accounts.CreateAsync(new AccountForm { Code = _newCode, Name = _newName }),
            "Hesap oluşturuldu.");
        _busy = false;

        if (!ok) return;

        _newCode = string.Empty;
        _newName = string.Empty;
        _showCreate = false;
        await LoadAsync();
    }
}
