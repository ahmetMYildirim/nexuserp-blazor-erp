@page "/abonelikler"
@attribute [Authorize]
@using NexusErp.Application.Subscriptions
@using NexusErp.Domain.Enums
@inject SubscriptionService SubscriptionService
@inject SubscriptionBillingService BillingService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Abonelikler · NexusERP</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Abonelikler</MudText>
    <MudSpacer />
    <AuthorizeView Roles="Admin,Muhasebe,Satis">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" Href="/abonelikler/yeni">
            Yeni Abonelik
        </MudButton>
    </AuthorizeView>
    @* Demo'nun en güçlü anı: iki kez bas, ikincisi 0 üretsin. *@
    <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@_running"
               StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunBillingNow">
        @if (_running)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
        }
        Faturalandırmayı Şimdi Çalıştır
    </MudButton>
</MudStack>

@if (_stats is not null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Aktif Abonelik" Value="@_stats.ActiveCount.ToString()"
                      Icon="@Icons.Material.Filled.Subscriptions" Color="Color.Primary" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="MRR" Value="@_stats.Mrr.ToMoney()" Suffix="₺"
                      Hint="Aylık tekrarlayan gelir"
                      Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="ARR" Value="@_stats.Arr.ToMoney()" Suffix="₺"
                      Hint="MRR × 12"
                      Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Info" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Bu Ay Yenilenecek" Value="@_stats.RenewingThisMonth.ToString()"
                      Icon="@Icons.Material.Filled.Autorenew" Color="Color.Warning" />
        </MudItem>
    </MudGrid>
}

@if (_lastRun is not null)
{
    <MudAlert Severity="@(_lastRun.Created > 0 ? Severity.Success : Severity.Info)"
              Class="mb-4" Dense ShowCloseIcon CloseIconClicked="@(() => _lastRun = null)">
        @_lastRun.Summary
        @if (_lastRun.Created == 0 && _lastRun.Skipped > 0)
        {
            <text> — aynı dönem için ikinci fatura üretilmedi (idempotency).</text>
        }
    </MudAlert>
}

<MudDataGrid T="SubscriptionListItem" Items="_items" Dense Hover Striped Elevation="1">
    <Columns>
        <PropertyColumn Property="x => x.PartyTitle" Title="Cari" />
        <PropertyColumn Property="x => x.PlanName" Title="Plan" />
        <TemplateColumn Title="Döngü">
            <CellTemplate>@CycleText(context.Item.Cycle)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Başlangıç">
            <CellTemplate>@context.Item.StartDate.ToString("dd.MM.yyyy")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Sonraki Fatura">
            <CellTemplate>
                <MudText Typo="Typo.body2"
                         Color="@(context.Item.NextBillingDate <= Today ? Color.Warning : Color.Inherit)">
                    @context.Item.NextBillingDate.ToString("dd.MM.yyyy")
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Çapa Günü">
            <CellTemplate>@context.Item.BillingAnchorDay</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Dönem Ücreti" HeaderClass="justify-end" CellClass="text-right">
            <CellTemplate>@context.Item.EffectivePrice.ToMoney() @context.Item.Currency</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Aylık Değer" HeaderClass="justify-end" CellClass="text-right">
            <CellTemplate>@context.Item.MonthlyValue.ToMoney()</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Durum">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @StatusText(context.Item.Status)
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" CellClass="d-flex justify-end">
            <CellTemplate>
                <MudTooltip Text="Detay — dönemler, faturalar, plan değişikliği">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                   Href="@($"/abonelikler/{context.Item.Id}")" />
                </MudTooltip>
                @if (context.Item.Status != SubscriptionStatus.Cancelled)
                {
                    <MudTooltip Text="İptal et">
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                                       OnClick="@(() => CancelAsync(context.Item))" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-6" Align="Align.Center">Abonelik bulunamadı.</MudText>
    </NoRecordsContent>
</MudDataGrid>

@* ─────────── FATURALANDIRMA ÖNİZLEMESİ ─────────── *@
@if (_showPreview && _preview is not null)
{
    <MudDialog Visible="true" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
        <TitleContent>Faturalandırma Önizlemesi</TitleContent>
        <DialogContent>
            <div class="kpi-hint" style="margin-bottom:10px">@_preview.Summary</div>

            <div class="scroll-x">
                <table class="table" style="min-width:520px">
                    <thead>
                        <tr>
                            <th>Cari</th><th>Plan</th><th>Dönem</th>
                            <th class="num">Tutar</th><th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _preview.Rows)
                        {
                            <tr>
                                <td>@r.PartyTitle</td>
                                <td>@r.PlanName</td>
                                <td>@PreviewPeriod(r)</td>
                                <td class="num">@r.Amount.ToMoney() @r.Currency</td>
                                <td>
                                    @if (r.AlreadyBilled)
                                    {
                                        <StatusTag Text="Zaten faturalanmış" Variant="neutral" />
                                    }
                                    else
                                    {
                                        <StatusTag Text="Kesilecek" Variant="accent" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3">Toplam (@_preview.BillableCount fatura)</td>
                            <td class="num">@_preview.Total.ToMoney() @_preview.Currency</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="kpi-hint" style="margin-top:10px">
                Zaten faturalanmış dönemler atlanır — aynı dönem için ikinci fatura
                üretilemez, bunu veri tabanındaki unique index garanti eder.
            </div>
        </DialogContent>
        <DialogActions>
            <button class="btn btn-secondary btn-sm" @onclick="CancelPreview">Vazgeç</button>
            <button class="btn btn-primary btn-sm" disabled="@_running"
                    @onclick="ConfirmBillingAsync">
                @ConfirmButtonText
            </button>
        </DialogActions>
    </MudDialog>
}

@code {
    private IReadOnlyList<SubscriptionListItem> _items = [];
    private SubscriptionStats? _stats;
    private BillingRunResult? _lastRun;
    private BillingRunPreview? _preview;
    private bool _showPreview;
    private bool _running;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await SubscriptionService.SearchAsync();
        _items = result.Items;
        _stats = await SubscriptionService.GetStatsAsync(Today);
    }

    /// <summary>
    /// ⚠️ Önce ÖNİZLEME, sonra onay, sonra kesim. Muhasebeci körlemesine buton
    /// basmak istemez — hangi cariye, hangi dönem için, ne kadar kesileceğini
    /// görmeden onay vermemeli. Önizleme hiçbir şey kaydetmez.
    /// </summary>
    private async Task RunBillingNow()
    {
        _running = true;
        _preview = await BillingService.PreviewRunAsync(Today);
        _running = false;

        if (_preview.BillableCount == 0)
        {
            Snackbar.Add(_preview.Summary, Severity.Info);
            _preview = null;
            return;
        }

        _showPreview = true;
    }

    private async Task ConfirmBillingAsync()
    {
        _showPreview = false;
        _running = true;
        _lastRun = await BillingService.RunAsync(Today);
        _running = false;
        _preview = null;

        Snackbar.Add(_lastRun.Summary,
                     _lastRun.Created > 0 ? Severity.Success : Severity.Info);
        await LoadAsync();
    }

    private void CancelPreview()
    {
        _showPreview = false;
        _preview = null;
    }

    // Markup'ta karmaşık ifade bırakmıyoruz (Razor brace/tırnak tuzakları)
    private string ConfirmButtonText =>
        $"{_preview!.BillableCount} Faturayı Kes";

    private static string PreviewPeriod(BillingPreviewRow r) =>
        $"{r.PeriodStart:dd.MM} – {r.PeriodEnd:dd.MM.yyyy}";

    private async Task CancelAsync(SubscriptionListItem item)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Aboneliği İptal Et",
            $"'{item.PartyTitle}' aboneliği dönem sonunda iptal edilsin mi?",
            yesText: "İptal Et", cancelText: "Vazgeç");

        if (confirmed != true) return;

        if (await Snackbar.RunAsync(
                () => SubscriptionService.CancelAsync(item.Id, Today, immediately: false),
                "Abonelik iptal edildi."))
            await LoadAsync();
    }

    private static string CycleText(BillingCycle c) => c switch
    {
        BillingCycle.Monthly => "Aylık",
        BillingCycle.Quarterly => "3 Aylık",
        BillingCycle.SemiAnnual => "6 Aylık",
        BillingCycle.Yearly => "Yıllık",
        _ => "?"
    };

    private static string StatusText(SubscriptionStatus s) => s switch
    {
        SubscriptionStatus.Trialing => "Deneme",
        SubscriptionStatus.Active => "Aktif",
        SubscriptionStatus.PastDue => "Vadesi Geçti",
        SubscriptionStatus.Paused => "Duraklatıldı",
        SubscriptionStatus.Cancelled => "İptal",
        _ => "?"
    };

    private static Color StatusColor(SubscriptionStatus s) => s switch
    {
        SubscriptionStatus.Trialing => Color.Info,
        SubscriptionStatus.Active => Color.Success,
        SubscriptionStatus.PastDue => Color.Error,
        SubscriptionStatus.Paused => Color.Warning,
        SubscriptionStatus.Cancelled => Color.Default,
        _ => Color.Default
    };
}
