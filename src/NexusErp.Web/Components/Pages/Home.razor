@page "/"
@attribute [Authorize]
@using NexusErp.Application.Dashboard
@using NexusErp.Application.Subscriptions
@using NexusErp.Domain.Enums
@inject DashboardService Dashboard
@inject NexusErp.Application.Accounting.AccountingReportService Accounting
@inject IJSRuntime JS
@using NexusErp.Application.Accounting

<PageTitle>Genel Bakış · NexusERP</PageTitle>

<AuthorizeView>
    <Authorized Context="auth">
        @{
            var canCollect = auth.User.IsInRole("Admin") || auth.User.IsInRole("Muhasebe");
            var isSales = auth.User.IsInRole("Satis");
            var canWrite = canCollect || isSales;
        }

        <PageHeader Kicker="@($"DÖNEM {DateTime.Today:MMMM yyyy}")"
                    Title="Genel Bakış"
                    Description="Günün alacak, tahsilat ve abonelik durumu">
            <Actions>
                <span class="text-muted">@DateTime.Today.ToString("dd MMMM yyyy")</span>
            </Actions>
        </PageHeader>

        @if (_data is null)
        {
            <div class="grid-kpi">
                @for (var i = 0; i < 4; i++)
                {
                    <Blueprint Class="bp-pad" Style="height:96px"></Blueprint>
                }
            </div>
        }
        else
        {
            <div class="stack">

                @* ─────────── 1. ANA KPI BANDI ─────────── *@
                <div class="grid-kpi">
                    <StatCard Title="Açık Alacak" Suffix="₺"
                              Value="@_data.OpenReceivables.ToMoney()"
                              Hint="@($"{_data.InvoiceCount} fatura kayıtlı")" />

                    <StatCard Title="Vadesi Geçen" Suffix="₺"
                              Value="@_data.OverdueReceivables.ToMoney()"
                              Hint="@($"{_data.OverdueInvoiceCount} fatura gecikmede")" />

                    <StatCard Title="MRR" Suffix="₺" Value="@_data.Mrr.ToMoney()"
                              Hint="@($"{_data.ActiveSubscriptions} abonelik · ARR {_data.Arr.ToMoney()} ₺")" />

                    <StatCard Title="Bu Ay Ciro (KDV hariç)" Suffix="₺"
                              Value="@_data.MonthRevenue.ToMoney()"
                              Delta="@(_data.PreviousMonthRevenue > 0 ? _data.RevenueChangePercent : null)"
                              Hint="geçen aya göre"
                              Sparkline="@_data.RevenueTrend.Select(t => t.Amount).ToList()" />
                </div>

                @* ─────────── 2. MİNİ İSTATİSTİK BANDI ───────────
                   Kartlar kullanıcı tercihine göre gösteriliyor. Grid auto-fit
                   olduğu için kart eklenip çıkarıldığında satır kendini yeniden
                   diziyor — boşluk kalmıyor, düzen bozulmuyor. *@
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:-6px">
                    <span class="mini-kicker">ÖZET GÖSTERGELER</span>
                    <span class="kpi-hint">@VisibleCards.Count / @AllCards.Count kart</span>
                    <button class="btn btn-ghost btn-sm" style="margin-left:auto"
                            @onclick="@(() => _editCards = !_editCards)">
                        @(_editCards ? "Bitti" : "Kartları Düzenle")
                    </button>
                </div>

                @if (_editCards)
                {
                    <Blueprint Class="bp-pad">
                        <div class="kpi-hint" style="margin-bottom:10px">
                            Görmek istediklerinizi seçin — tercihiniz bu tarayıcıda saklanır.
                        </div>
                        <div style="display:flex;flex-wrap:wrap;gap:10px 20px">
                            @foreach (var card in AllCards)
                            {
                                <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                                    <input type="checkbox" checked="@_hidden.Contains(card.Key) == false"
                                           @onchange="@(e => ToggleCard(card.Key, e))" />
                                    <span>@card.Label</span>
                                </label>
                            }
                        </div>
                    </Blueprint>
                }

                <div class="grid-mini">
                    @foreach (var card in VisibleCards)
                    {
                        <MiniStat Label="@card.Label" Value="@card.Value" Hint="@card.Hint" />
                    }
                </div>

                @* ─────────── 2b. MUHASEBE DEFTERİ ───────────
                   Defterin denk olup olmadığı ANA EKRANDA duruyor: dengesizlik ay
                   sonunda mizan açıldığında değil, oluştuğu gün görülmeli. Dengesiz
                   defterde ciro, kâr ve bilanço rakamlarının hiçbiri güvenilir değil. *@
                @{
                    var acc = _data.Accounting;
                }
                <Blueprint Class="bp-pad">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
                        <h5 style="margin:0">Muhasebe Defteri</h5>
                        <span class="kpi-hint">@DateTime.Today.Year yılı · kesinleşmiş fişler</span>
                        <span style="margin-left:auto;display:flex;align-items:center;gap:10px">
                            @if (acc.EntryCount == 0)
                            {
                                <StatusTag Text="KAYIT YOK" Variant="neutral" />
                            }
                            else if (acc.IsBalanced)
                            {
                                <StatusTag Text="DEFTER DENK" Variant="accent-2" />
                            }
                            else
                            {
                                <StatusTag Text="DEFTER DENK DEĞİL" Variant="outline" />
                                <span class="kpi-hint">
                                    Fark @((acc.TotalDebit - acc.TotalCredit).ToMoney()) ₺
                                </span>
                            }
                            <a class="btn btn-ghost btn-sm" href="/mizan">Mizan</a>
                            <a class="btn btn-ghost btn-sm" href="/bilanco">Bilanço</a>
                        </span>
                    </div>

                    <div class="grid-mini">
                        <MiniStat Label="Muhasebe Fişi" Value="@acc.EntryCount.ToString()"
                                  Hint="@($"{acc.AutoPostedCount} otomatik · {acc.ManualCount} elle")" />
                        <MiniStat Label="Defter Borç" Value="@($"{acc.TotalDebit.ToMoney()} ₺")" />
                        <MiniStat Label="Defter Alacak" Value="@($"{acc.TotalCredit.ToMoney()} ₺")" />
                        <MiniStat Label="Dönem Geliri" Value="@($"{acc.Revenue.ToMoney()} ₺")"
                                  Hint="KDV hariç satış" />
                        <MiniStat Label="Dönem Gideri" Value="@($"{acc.Expense.ToMoney()} ₺")" />
                        <MiniStat Label="@(acc.IsProfit ? "Dönem Net Kârı" : "Dönem Net Zararı")"
                                  Value="@($"{Math.Abs(acc.PeriodResult).ToMoney()} ₺")"
                                  Hint="gelir − gider" />
                        <MiniStat Label="Bekleyen Taslak" Value="@acc.DraftCount.ToString()"
                                  Hint="@(acc.DraftCount > 0 ? "rapora girmiyor" : "yok")" />
                    </div>

                    @* Aylık gelir/gider — yalnızca HAREKET OLAN aylar çizilir.
                       12 ayın tamamı çizilince dolu 2-3 ay ince çubuklara sıkışıp
                       grafik okunmaz hale geliyordu. *@
                    @if (_monthly.Count > 0)
                    {
                        <div style="margin-top:16px">
                            @* Üç grafik YAN YANA: her biri farklı bir soruya cevap
                               veriyor, bu yüzden birini seçtirmek yerine üçü birden
                               gösteriliyor. Dar ekranda alt alta iner. *@
                            @* ⚠️ TEK grafik, TAM GENİŞLİK. Üçü yan yana konunca her
                               sütun daralıyor ve çubuklar okunmaz hale geliyordu;
                               kullanıcı hangisini göreceğini seçiyor. *@
                            <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:10px">
                                <div>
                                    <div class="mini-kicker">@ChartTitle</div>
                                    <div class="kpi-hint" style="margin-top:2px">@ChartHint</div>
                                </div>
                                <div style="margin-left:auto;display:flex;gap:6px">
                                    <button class="btn @BtnClass("aylik")" @onclick="@(() => _chart = "aylik")">Aylık Gelir / Gider</button>
                                    <button class="btn @BtnClass("kumulatif")" @onclick="@(() => _chart = "kumulatif")">Kümülatif Kâr</button>
                                    <button class="btn @BtnClass("hesap")" @onclick="@(() => _chart = "hesap")">Hesap Bakiyeleri</button>
                                </div>
                            </div>

                            @if (_chart == "aylik") { @MonthlyBars() }
                            else if (_chart == "kumulatif") { @CumulativeBars() }
                            else { @AccountBars() }
                        </div>
                    }
                </Blueprint>

                @* ─────────── 3. TREND + YAŞLANDIRMA ─────────── *@
                <div class="grid-2">
                    <Blueprint Class="bp-pad">
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px">
                            <h5>Son 12 Ay</h5>
                            <span style="margin-left:auto;display:flex;align-items:center;gap:12px">
                                <span class="kpi-hint">
                                    <svg width="16" height="3" style="vertical-align:middle">
                                        <line x1="0" y1="1.5" x2="16" y2="1.5"
                                              stroke="var(--color-accent)" stroke-width="2" />
                                    </svg> Ciro
                                </span>
                                <span class="kpi-hint">
                                    <svg width="16" height="3" style="vertical-align:middle">
                                        <line x1="0" y1="1.5" x2="16" y2="1.5"
                                              stroke="var(--color-accent-600)" stroke-width="1.5"
                                              stroke-dasharray="3 3" />
                                    </svg> Tahsilat
                                </span>
                            </span>
                        </div>
                        @TrendChart()
                    </Blueprint>

                    @if (canCollect)
                    {
                        <Blueprint Class="bp-pad">
                            <h5 style="margin-bottom:10px">Yaşlandırma</h5>
                            @AgingStack(_data.AgingBuckets)
                            <table class="table" style="margin-top:10px">
                                <tbody>
                                    @foreach (var (label, value) in AgingRows(_data.AgingBuckets))
                                    {
                                        <tr>
                                            <td>@label</td>
                                            <td class="num">@Fmt(value)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>Toplam</td>
                                        <td class="num">@Fmt(_data.AgingBuckets.Total)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </Blueprint>
                    }
                    else
                    {
                        @* Satış rolü tahsilat panellerini görmez — ürün kırılımını görür *@
                        <Blueprint Class="bp-pad">
                            <h5 style="margin-bottom:10px">Bu Ay Ürün Kırılımı</h5>
                            @ProductBars()
                        </Blueprint>
                    }
                </div>

                @* ─────────── 4. DURUM · ALACAKLI · ABONELİK ─────────── *@
                <div class="grid-3">
                    <Blueprint Class="bp-pad">
                        <h5 style="margin-bottom:10px">Fatura Durumları</h5>
                        @if (_data.StatusBreakdown.Count == 0)
                        {
                            <div class="text-muted">Henüz fatura yok.</div>
                        }
                        else
                        {
                            @foreach (var s in _data.StatusBreakdown.OrderBy(x => x.Status))
                            {
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
                                    <StatusTag Text="@StatusText(s.Status)" Variant="@StatusVariant(s.Status)" />
                                    <span class="text-muted" style="font-size:11px">@s.Count adet</span>
                                    <span class="num" style="margin-left:auto;font-weight:600">@Fmt(s.Amount)</span>
                                </div>
                                <div class="bar-track" style="margin-bottom:10px">
                                    <div class="bar-fill" style="width:@(ShareOf(s.Amount).ToString("0.#", Inv))%"></div>
                                </div>
                            }
                        }
                    </Blueprint>

                    <Blueprint Class="bp-pad">
                        <h5 style="margin-bottom:10px">En Çok Alacaklı Cariler</h5>
                        @if (_data.TopDebtors.Count == 0)
                        {
                            <div class="text-muted">Açık alacak yok.</div>
                        }
                        else
                        {
                            <table class="table">
                                <tbody>
                                    @foreach (var d in _data.TopDebtors)
                                    {
                                        <tr>
                                            <td>
                                                @d.Title
                                                <div class="text-muted" style="font-size:11px">
                                                    @d.InvoiceCount açık fatura
                                                </div>
                                            </td>
                                            <td class="num">@Fmt(d.Amount)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </Blueprint>

                    <Blueprint Class="bp-pad">
                        <h5 style="margin-bottom:10px">Abonelik Hareketi</h5>
                        @{
                            var m = _data.SubscriptionMovement;
                        }
                        <table class="table">
                            <tbody>
                                <tr><td>Bu ay yeni</td><td class="num">@m.NewCount</td></tr>
                                <tr><td>Bu ay iptal</td><td class="num">@m.CancelledCount</td></tr>
                                <tr>
                                    <td>MRR değişimi</td>
                                    <td class="num">@(m.MrrDelta >= 0 ? "+" : "")@Fmt(m.MrrDelta)</td>
                                </tr>
                                <tr><td>Churn</td><td class="num">%@m.ChurnRate.ToString("N1")</td></tr>
                                <tr>
                                    <td>Bu hafta faturalanacak</td>
                                    <td class="num">@m.BillingThisWeek adet</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>Hafta tutarı</td>
                                    <td class="num">@Fmt(m.BillingThisWeekAmount)</td>
                                </tr>
                            </tfoot>
                        </table>

                        @* Churn ORANI değil, SEBEBİ — fiyat sorunu ile ürün sorunu
                           bambaşka aksiyon gerektirir. *@
                        <div class="kpi-kicker" style="margin-top:12px">
                            NEDEN KAYBEDİLDİ · SON 90 GÜN
                        </div>
                        @if (_data.Churn.CancelledCount == 0)
                        {
                            <div class="text-muted" style="margin-top:4px">
                                Bu dönemde iptal yok.
                            </div>
                        }
                        else
                        {
                            <table class="table" style="margin-top:4px">
                                <tbody>
                                    @foreach (var r in _data.Churn.Reasons)
                                    {
                                        <tr>
                                            <td>@r.Label</td>
                                            <td class="num">@r.Count</td>
                                            <td class="num">@Fmt(r.LostMrr)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>Kayıp MRR</td>
                                        <td class="num">@_data.Churn.CancelledCount</td>
                                        <td class="num">@Fmt(_data.Churn.LostMrr)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                    </Blueprint>
                </div>

                @* ─────────── 5. YAKLAŞAN VADELER + ROL PANELİ ─────────── *@
                <div class="grid-2">
                    <Blueprint Class="bp-pad">
                        <h5 style="margin-bottom:10px">Yaklaşan Vadeler</h5>
                        @if (_data.UpcomingDue.Count == 0)
                        {
                            <div class="text-muted">Vadesi yaklaşan fatura yok.</div>
                        }
                        else
                        {
                            <div class="scroll-x">
                                <table class="table" style="min-width:520px">
                                    <thead>
                                        <tr>
                                            <th>Fatura No</th><th>Cari</th><th>Vade</th>
                                            <th class="num">Kalan</th><th class="num">Gün</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var i in _data.UpcomingDue)
                                        {
                                            <tr>
                                                <td class="mono">@i.Number</td>
                                                <td>@i.PartyTitle</td>
                                                <td>@i.DueDate.ToString("dd.MM.yyyy")</td>
                                                <td class="num">@Fmt(i.Remaining)</td>
                                                <td class="num">
                                                    @if (i.DaysLeft <= 3)
                                                    {
                                                        <StatusTag Text="@($"{i.DaysLeft} gün")" Variant="outline" />
                                                    }
                                                    else
                                                    {
                                                        @($"{i.DaysLeft} gün")
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </Blueprint>

                    @if (canCollect)
                    {
                        <Blueprint Class="bp-pad">
                            <h5 style="margin-bottom:10px">Eşleşme Bekleyen</h5>
                            @if (_data.UnallocatedPayments.Count == 0)
                            {
                                <div class="text-muted">Eşleşmemiş tahsilat yok.</div>
                            }
                            else
                            {
                                <table class="table">
                                    <tbody>
                                        @foreach (var p in _data.UnallocatedPayments)
                                        {
                                            <tr>
                                                <td>
                                                    @p.PartyTitle
                                                    <div class="text-muted mono" style="font-size:11px">
                                                        @(p.Reference ?? p.Number ?? "—")
                                                    </div>
                                                </td>
                                                <td class="num">@Fmt(p.Amount)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <a class="btn btn-secondary btn-sm" href="/tahsilatlar"
                                   style="margin-top:10px">Tahsilatlara git</a>
                            }
                        </Blueprint>
                    }
                    else
                    {
                        <Blueprint Class="bp-pad">
                            <h5 style="margin-bottom:10px">Bekleyen İşlerim</h5>
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <td>Taslak fatura</td>
                                        <td class="num">@_data.DraftInvoiceCount</td>
                                    </tr>
                                    <tr>
                                        <td>Vadesi geçen fatura</td>
                                        <td class="num">@_data.OverdueInvoiceCount</td>
                                    </tr>
                                    <tr>
                                        <td>Bu hafta yenilenecek abonelik</td>
                                        <td class="num">@_data.SubscriptionMovement.BillingThisWeek</td>
                                    </tr>
                                </tbody>
                            </table>
                            @if (canWrite)
                            {
                                <a class="btn btn-primary btn-sm" href="/faturalar/yeni"
                                   style="margin-top:10px">Yeni fatura</a>
                            }
                        </Blueprint>
                    }
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private static readonly System.Globalization.CultureInfo Inv =
        System.Globalization.CultureInfo.InvariantCulture;

    private DashboardSummary? _data;
    private IReadOnlyList<MonthlyResult> _monthly = [];
    private IReadOnlyList<TrialBalanceRow> _balances = [];

    // ---------------- Özelleştirilebilir kartlar ----------------

    private sealed record StatCardDef(string Key, string Label, string Value, string? Hint = null);

    private bool _editCards;
    private HashSet<string> _hidden = [];

    /// <summary>
    /// Kart tanımları TEK yerde: hem seçim listesi hem de gösterim buradan
    /// üretiliyor, böylece biri eklenip diğeri unutulamaz.
    /// </summary>
    private List<StatCardDef> AllCards
    {
        get
        {
            var d = _data!;
            return
            [
                new("tahsilat-orani", "Tahsilat Oranı", $"%{d.CollectionRate:N1}"),
                new("ay-tahsilat", "Bu Ay Tahsilat", $"{d.MonthCollected.ToMoney()} ₺"),
                new("dso", "Ort. Tahsil Süresi", $"{d.DaysSalesOutstanding:N1} gün", "DSO"),
                new("ort-fatura", "Ortalama Fatura", $"{d.AverageInvoice.ToMoney()} ₺"),
                new("ay-kesilen", "Bu Ay Kesilen", d.IssuedThisMonth.ToString()),
                new("taslak", "Taslak", d.DraftInvoiceCount.ToString()),
                new("aktif-cari", "Aktif Cari", d.PartyCount.ToString()),
                // ⚠️ Borç ALACAK kartına karışmıyor: alış faturaları ayrı hesaplanır.
                new("tedarikci-borcu", "Tedarikçi Borcu", $"{d.OpenPayables.ToMoney()} ₺",
                    d.OverduePayables > 0
                        ? $"{d.OverduePayables.ToMoney()} ₺ vadesi geçti" : "vadesi geçen yok"),
                // Net pozisyon nakit değil TAHAKKUK — henüz tahsil/ödeme yapılmamış olabilir.
                new("net-pozisyon", "Net Pozisyon", $"{d.NetPosition.ToMoney()} ₺", "alacak − borç"),
                new("mrr", "MRR", $"{d.Mrr.ToMoney()} ₺", $"{d.ActiveSubscriptions} abonelik"),
                new("vadesi-gecen", "Vadesi Geçen", $"{d.OverdueReceivables.ToMoney()} ₺",
                    $"{d.OverdueInvoiceCount} fatura"),
                new("fis-sayisi", "Muhasebe Fişi", d.Accounting.EntryCount.ToString(),
                    d.Accounting.IsBalanced ? "defter denk" : "DEFTER DENK DEĞİL")
            ];
        }
    }

    private List<StatCardDef> VisibleCards =>
        [.. AllCards.Where(c => !_hidden.Contains(c.Key))];

    private async Task ToggleCard(string key, ChangeEventArgs e)
    {
        if (e.Value is bool show && show) _hidden.Remove(key);
        else _hidden.Add(key);

        await JS.InvokeVoidAsync("localStorage.setItem",
                                 "nexus.hiddenCards", string.Join(',', _hidden));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "nexus.hiddenCards");
        if (!string.IsNullOrWhiteSpace(saved))
        {
            _hidden = [.. saved.Split(',', StringSplitOptions.RemoveEmptyEntries)];
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _data = await Dashboard.GetAsync(DateOnly.FromDateTime(DateTime.Today));

        // Boş ayları at: dolu 2-3 ay 12 slota yayılınca çubuklar iğne gibi
        // kalıyor ve grafik hiçbir şey anlatmıyor.
        _monthly = [.. (await Accounting.GetMonthlyResultsAsync(DateTime.Today.Year))
            .Where(m => m.Revenue != 0m || m.Expense != 0m)];

        var mizan = await Accounting.GetTrialBalanceAsync(
            new DateOnly(DateTime.Today.Year, 1, 1), new DateOnly(DateTime.Today.Year, 12, 31));
        _balances = [.. mizan.Rows.Where(r => r.Balance != 0m)
            .OrderByDescending(r => Math.Abs(r.Balance)).Take(5)];
    }

    private string _chart = "aylik";

    private string BtnClass(string key) =>
        _chart == key ? "btn-primary btn-sm" : "btn-ghost btn-sm";

    private string ChartTitle => _chart switch
    {
        "kumulatif" => "KÜMÜLATİF NET KÂR",
        "hesap" => "EN BÜYÜK HESAP BAKİYELERİ",
        _ => "AYLIK GELİR VE GİDER"
    };

    private string ChartHint => _chart switch
    {
        "kumulatif" => "Yıl başından o aya kadar biriken kâr — genel gidişat",
        "hesap" => "Paranın ve borcun hangi hesaplarda toplandığı",
        _ => "Hangi ay ne kadar kazandınız, ne kadar harcadınız (koyu: gelir · soluk: gider)"
    };

    /// <summary>Ay ay birikerek giden net kâr — yılın gidişatı tek çizgide.</summary>
    private RenderFragment CumulativeBars() => builder =>
    {
        var html = new System.Text.StringBuilder();
        var running = 0m;
        var totals = new List<(string Label, decimal Value)>();
        foreach (var m in _monthly) { running += m.Result; totals.Add((m.Label, running)); }

        var max = totals.Count == 0 ? 1m : totals.Max(t => Math.Abs(t.Value));
        if (max <= 0m) max = 1m;

        html.Append("<div style=\"display:flex;align-items:flex-end;gap:18px;padding-top:18px\">");
        foreach (var t in totals)
        {
            var h = (double)(Math.Abs(t.Value) / max) * 100.0;
            html.Append("<div style=\"flex:1;display:flex;flex-direction:column;align-items:center;gap:5px\">")
                .Append("<div style=\"display:flex;align-items:flex-end;justify-content:center;height:120px;width:100%\">")
                .Append(string.Create(Inv,
                    $"<div style=\"flex:1;max-width:70px;height:{h:0.#}%;min-height:2px;background:var(--color-accent)\"></div>"))
                .Append("</div>")
                .Append($"<span class=\"kpi-hint\">{t.Label}</span>")
                .Append($"<span style=\"font-size:11px;font-variant-numeric:tabular-nums\">{t.Value.ToMoney()}</span>")
                .Append("</div>");
        }
        html.Append("</div>");
        builder.AddMarkupContent(0, html.ToString());
    };

    /// <summary>Defterdeki en büyük beş hesap bakiyesi — yatay çubuk.</summary>
    private RenderFragment AccountBars() => builder =>
    {
        var html = new System.Text.StringBuilder();
        if (_balances.Count == 0)
        {
            html.Append("<div class=\"text-muted\">Hareket gören hesap yok.</div>");
            builder.AddMarkupContent(0, html.ToString());
            return;
        }

        var max = _balances.Max(r => Math.Abs(r.Balance));
        if (max <= 0m) max = 1m;

        html.Append("<div style=\"padding-top:10px\">");
        foreach (var row in _balances)
        {
            var pct = Math.Abs(row.Balance) / max * 100m;
            var side = row.Balance > 0 ? "borç" : "alacak";
            html.Append("<div style=\"display:flex;align-items:center;gap:8px;margin-bottom:3px\">")
                .Append($"<span style=\"flex:1\"><b>{row.Code}</b> {System.Net.WebUtility.HtmlEncode(row.Name)} <span class=\"kpi-hint\">· {side} bakiye</span></span>")
                .Append($"<span class=\"num\" style=\"font-weight:600\">{Math.Abs(row.Balance):N2}</span></div>")
                .Append("<div class=\"bar-track\" style=\"margin-bottom:10px\">")
                .Append(string.Create(Inv, $"<div class=\"bar-fill\" style=\"width:{pct:0.##}%\"></div>"))
                .Append("</div>");
        }
        html.Append("</div>");
        builder.AddMarkupContent(0, html.ToString());
    };

    /// <summary>Aylık gelir/gider sütunları — kalın çubuklar, üstünde tutar.</summary>
    private RenderFragment MonthlyBars() => builder =>
    {
        var max = _monthly.Max(m => Math.Max(m.Revenue, m.Expense));
        if (max <= 0m) max = 1m;

        var html = new System.Text.StringBuilder();
        // Sütunlar panelin TAMAMINA yayılır (flex:1). Sabit genişlikte olunca
        // grafik sola sıkışıp sağda kocaman boşluk kalıyordu.
        html.Append("<div style=\"display:flex;align-items:flex-end;gap:18px;padding-top:18px\">");

        foreach (var m in _monthly)
        {
            var rh = (double)(m.Revenue / max) * 100.0;
            var eh = (double)(m.Expense / max) * 100.0;

            html.Append("<div style=\"flex:1;display:flex;flex-direction:column;align-items:center;gap:5px\">")
                .Append("<div style=\"display:flex;align-items:flex-end;justify-content:center;gap:6px;height:120px;width:100%\">")
                .Append(string.Create(Inv,
                    $"<div title=\"Gelir {m.Revenue:N2}\" style=\"flex:1;max-width:54px;height:{rh:0.#}%;min-height:2px;background:var(--color-accent)\"></div>"))
                .Append(string.Create(Inv,
                    $"<div title=\"Gider {m.Expense:N2}\" style=\"flex:1;max-width:54px;height:{eh:0.#}%;min-height:2px;background:var(--color-accent-600);opacity:.45\"></div>"))
                .Append("</div>")
                .Append($"<span class=\"kpi-hint\">{m.Label}</span>")
                .Append($"<span style=\"font-size:11px;font-variant-numeric:tabular-nums\">{m.Revenue.ToMoney()}</span>")
                .Append("</div>");
        }

        html.Append("</div>");
        builder.AddMarkupContent(0, html.ToString());
    };

    private static string Fmt(decimal v) => v == 0m ? "—" : v.ToMoney();

    private double ShareOf(decimal amount)
    {
        var total = _data!.StatusBreakdown.Sum(x => x.Amount);
        return total == 0 ? 0 : (double)(amount / total * 100m);
    }

    private static IEnumerable<(string Label, decimal Value)> AgingRows(AgingBuckets a) =>
    [
        ("Vadesi gelmemiş", a.NotDue),
        ("1–30 gün", a.Days1To30),
        ("31–60 gün", a.Days31To60),
        ("61–90 gün", a.Days61To90),
        ("90+ gün", a.Over90)
    ];

    /// <summary>Yaşlandırma yığın çubuğu — beş dilim, koyu temada ters rampa okunur kalır.</summary>
    private RenderFragment AgingStack(AgingBuckets a) => builder =>
    {
        var total = a.Total;
        if (total <= 0m)
        {
            builder.AddMarkupContent(0, "<div class=\"text-muted\">Açık alacak yok.</div>");
            return;
        }

        var slices = new (decimal Value, string Color)[]
        {
            (a.NotDue,      "var(--color-accent-200)"),
            (a.Days1To30,   "var(--color-accent-400)"),
            (a.Days31To60,  "var(--color-accent-600)"),
            (a.Days61To90,  "var(--color-accent-800)"),
            (a.Over90,      "var(--color-accent-900)")
        };

        var html = new System.Text.StringBuilder(
            "<div style=\"display:flex;height:26px;overflow:hidden\">");

        foreach (var (value, color) in slices)
        {
            if (value <= 0m) continue;
            var pct = (value / total * 100m).ToString("0.##", Inv);
            html.Append($"<div style=\"width:{pct}%;background:{color}\"></div>");
        }

        html.Append("</div>");
        builder.AddMarkupContent(0, html.ToString());
    };

    /// <summary>Ürün kırılımı oran çubukları.</summary>
    private RenderFragment ProductBars() => builder =>
    {
        var rows = _data!.ProductBreakdown;
        if (rows.Count == 0)
        {
            builder.AddMarkupContent(0, "<div class=\"text-muted\">Bu ay kesilmiş fatura yok.</div>");
            return;
        }

        var max = rows.Max(r => r.Amount);
        var html = new System.Text.StringBuilder();

        foreach (var r in rows)
        {
            var pct = max <= 0m ? "0" : (r.Amount / max * 100m).ToString("0.#", Inv);
            html.Append("<div style=\"display:flex;align-items:center;gap:8px;margin-bottom:3px\">")
                .Append($"<span style=\"flex:1;min-width:0\">{System.Net.WebUtility.HtmlEncode(r.Name)}</span>")
                .Append($"<span class=\"num\" style=\"font-weight:600\">{r.Amount.ToMoney()}</span></div>")
                .Append("<div class=\"bar-track\" style=\"margin-bottom:9px\">")
                .Append($"<div class=\"bar-fill\" style=\"width:{pct}%\"></div></div>");
        }

        builder.AddMarkupContent(0, html.ToString());
    };

    /// <summary>12 ay çizgi grafiği — kütüphane yok, düz SVG (components.md §10).</summary>
    private RenderFragment TrendChart() => builder =>
    {
        var revenue = _data!.RevenueTrend;
        var collected = _data.CollectionTrend;

        const int w = 730, h = 232, padL = 4, padB = 18, padT = 8;
        var max = Math.Max(revenue.Max(t => t.Amount), collected.Max(t => t.Amount));
        if (max <= 0m) max = 1m;

        string Points(IReadOnlyList<MonthlyRevenue> src)
        {
            var parts = new string[src.Count];
            for (var i = 0; i < src.Count; i++)
            {
                var x = padL + (w - padL * 2) * i / (double)(src.Count - 1);
                var y = h - padB - (double)(src[i].Amount / max) * (h - padB - padT);
                parts[i] = string.Create(Inv, $"{x:0.#},{y:0.#}");
            }
            return string.Join(' ', parts);
        }

        var svg = new System.Text.StringBuilder();
        svg.Append($"<svg viewBox=\"0 0 {w} {h}\" width=\"100%\" height=\"232\" role=\"img\" aria-label=\"Son 12 ay ciro ve tahsilat\">");

        // Yatay kılavuz çizgileri
        for (var g = 0; g <= 4; g++)
        {
            var y = padT + (h - padB - padT) * g / 4.0;
            svg.Append(string.Create(Inv,
                $"<line x1=\"{padL}\" y1=\"{y:0.#}\" x2=\"{w - padL}\" y2=\"{y:0.#}\" stroke=\"var(--color-divider)\" stroke-width=\"1\" stroke-dasharray=\"2 4\" />"));
        }

        svg.Append($"<polyline points=\"{Points(collected)}\" fill=\"none\" stroke=\"var(--color-accent-600)\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\" />");
        svg.Append($"<polyline points=\"{Points(revenue)}\" fill=\"none\" stroke=\"var(--color-accent)\" stroke-width=\"2\" />");

        // Eksen etiketleri — her üç ayda bir, kalabalık olmasın
        for (var i = 0; i < revenue.Count; i += 3)
        {
            var x = padL + (w - padL * 2) * i / (double)(revenue.Count - 1);
            svg.Append(string.Create(Inv,
                $"<text x=\"{x:0.#}\" y=\"{h - 4}\" font-size=\"9.5\" fill=\"currentColor\" opacity=\".55\">{revenue[i].Label}</text>"));
        }

        svg.Append("</svg>");
        builder.AddMarkupContent(0, svg.ToString());
    };

    private static string StatusText(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "Taslak",
        InvoiceStatus.Issued => "Kesildi",
        InvoiceStatus.PartiallyPaid => "Kısmi Tahsil",
        InvoiceStatus.Paid => "Tahsil Edildi",
        InvoiceStatus.Cancelled => "İptal",
        _ => "?"
    };

    private static string StatusVariant(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Issued => "accent",
        InvoiceStatus.Paid => "accent-2",
        InvoiceStatus.PartiallyPaid => "outline",
        _ => "neutral"
    };
}
