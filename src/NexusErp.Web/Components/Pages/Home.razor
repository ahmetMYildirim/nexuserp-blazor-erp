@page "/"
@rendermode InteractiveServer

<PageTitle>Genel Bakış · NexusERP</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Genel Bakış</MudText>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    Dashboard <strong>Bölüm 11</strong>'de gerçek verilerle dolacak.
    Şu an iskelet çalışıyor: MudBlazor, tema, menü ve interaktif render aktif.
</MudAlert>

<MudGrid>
    @foreach (var card in _placeholders)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4" Style="height:100%">
                <MudStack Row AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.caption">@card.Title</MudText>
                        <MudText Typo="Typo.h5" Class="mt-1">—</MudText>
                    </div>
                    <MudAvatar Color="@card.Color" Variant="Variant.Outlined">
                        <MudIcon Icon="@card.Icon" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Elevation="0" Class="pa-4 mt-6" Style="max-width:640px">
    <MudText Typo="Typo.subtitle1" Class="mb-2">Kurulum durumu</MudText>
    <MudList T="string" Dense>
        <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
            .NET 9 · Blazor Server · MudBlazor
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
            PostgreSQL 17 (Docker, port 5433) · pgAdmin (5050)
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
            Domain katmanı: Money, TaxIdentifier, entity'ler
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.RadioButtonUnchecked" IconColor="Color.Default">
            Sıradaki: Bölüm 05 — EF Core, migration, seed
        </MudListItem>
    </MudList>

    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.TouchApp" OnClick="@(() => _clicks++)">
        İnteraktivite testi (@_clicks)
    </MudButton>
</MudPaper>

@code {
    private int _clicks;

    private readonly (string Title, string Icon, Color Color)[] _placeholders =
    [
        ("Açık Alacak",   Icons.Material.Filled.AccountBalanceWallet, Color.Primary),
        ("Vadesi Geçen",  Icons.Material.Filled.Warning,              Color.Error),
        ("MRR",           Icons.Material.Filled.Autorenew,            Color.Success),
        ("Bu Ay Ciro",    Icons.Material.Filled.TrendingUp,           Color.Info),
    ];
}
