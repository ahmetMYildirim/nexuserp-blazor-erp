@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav

@* MudBlazor'ın 4 provider'ı — biri eksikse dialog/snackbar/popover çalışmaz *@
<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@*
    Kabuk (UI v2, docs/ui-v2): 44px üst bar + 32px modül menüsü + 33px
    breadcrumb/işlem çubuğu + [186px kısayol paneli | içerik] + 23px durum çubuğu.

    ⚠️ Belge sekmeleri (docs/ui-v2 §"Belge sekmeleri") ve bildirim paneli bu
    turda BİLEREK dışarıda bırakıldı: sekmeler oturum/tab durumu izlemek
    gerektiriyor, bildirimler ayrı bir servis ister — ikisi de tek başına ayrı
    bir iş. Kalan beş şerit tasarımın çekirdeğini oluşturuyor ve her sayfada
    görünür, bu yüzden önce onlar kuruldu.
*@
<div style="height:100vh;display:flex;flex-direction:column;background:var(--color-bg);overflow:hidden">

    @* z-index: arama listesi modül menüsünün üstünde kalsın. Liste bu barın
       ÇOCUĞU olduğu için barın kendi stacking context'i menüden yüksek olmalı;
       yalnızca listeye z-index vermek yetmiyor. *@
    <header class="nx-topbar" style="z-index:500">
        <a class="nx-topbar-brand" href="/" style="color:inherit;text-decoration:none"
           title="Genel Bakış">NEXUSERP</a>
        <span class="nx-topbar-sep"></span>
        <span class="nx-topbar-tenant">@TenantName</span>

        @* Arama: sayfa/modül bulucu. Ctrl+K odaklar, ok tuşları gezinir,
           Enter açar. Veri araması değil — cari/fatura araması ilgili
           listelerin kendi filtresinde. *@
        @* Sayfa bulucu: yaz, Enter'a bas, en iyi eşleşen sayfa açılır.
           Açılır liste denendi ve kaldırıldı — Razor markup'ında dinamik liste
           + tuple lambda + iç içe tırnak kombinasyonu derleyiciyi ilgisiz
           hatalara sürüklüyordu; kazanç riske değmedi. *@
        <span style="position:relative;display:flex">
            <input class="nx-search" type="search" placeholder="Ara…  Ctrl+K"
                   aria-label="Sayfa ara" id="nx-global-search"
                   title="Sayfa adı yazıp Enter'a basın (Ctrl+K)"
                   value="@_query" @oninput="OnSearchInput" @onkeydown="OnSearchKeyDown" />

            @if (Matches.Count > 0)
            {
                <div class="blueprint" style="@DropdownStyle">
                    @foreach (var item in Matches)
                    {
                        <a href="@item.Href" class="nx-dropdown-item">
                            <strong>@item.Title</strong>
                            <span class="text-muted">@item.Group</span>
                        </a>
                    }
                </div>
            }
        </span>

        <span style="margin-left:auto;display:flex;align-items:center;gap:10px">
            <span class="nx-topbar-tenant">@PeriodLabel</span>

            <button type="button" class="nx-topbar-btn" @onclick="ToggleThemeAsync"
                    title="@(_isDark ? "Açık temaya geç" : "Koyu temaya geç")">
                @if (_isDark)
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                    </svg>
                    <span>Açık</span>
                }
                else
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5">
                        <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
                    </svg>
                    <span>Koyu</span>
                }
            </button>

            <AuthorizeView>
                <Authorized>
                    <span style="position:relative;display:flex">
                        <button type="button" class="nx-user" style="border:0;cursor:pointer"
                                @onclick="@(() => _profileOpen = !_profileOpen)">
                            <span class="nx-user-initials">@Initials(FullNameOf(context))</span>
                            <span style="display:flex;flex-direction:column;line-height:1.25">
                                <span style="font-size:11.5px">@FullNameOf(context)</span>
                                <span style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;opacity:.6">
                                    @RoleOf(context)
                                </span>
                            </span>
                        </button>

                        @if (_profileOpen)
                        {
                            <div class="blueprint" style="@DropdownStyle;right:0;left:auto"
                                 @onmouseleave="@(() => _profileOpen = false)">
                                <a class="nx-dropdown-item" href="/profil">
                                    <strong>Profilim</strong>
                                    <span class="text-muted">kişisel bilgiler</span>
                                </a>
                                <a class="nx-dropdown-item" href="/ayarlar">
                                    <strong>Ayarlar</strong>
                                    <span class="text-muted">tema, sol panel</span>
                                </a>
                                <div style="border-top:1px solid var(--color-divider);margin:4px 0"></div>
                                @* Çıkış POST olmalı — cookie silmek HttpContext gerektiriyor *@
                                <form method="post" action="/hesap/cikis" style="margin:0">
                                    <AntiforgeryToken />
                                    <button type="submit" class="nx-dropdown-item"
                                            style="width:100%;border:0;background:transparent;cursor:pointer;text-align:left">
                                        <strong>Oturumu kapat</strong>
                                    </button>
                                </form>
                            </div>
                        }
                    </span>
                </Authorized>
            </AuthorizeView>
        </span>
    </header>

    <ModuleNav />

    @* Breadcrumb + sayfaya özel işlem çubuğu. Kırıntı, MainLayout'un zaten
       tuttuğu sayfa listesinden (arama için kullanılan Pages) türetiliyor —
       ayrı bir eşleme tablosu bakımı gerektirmesin diye. *@
    <div class="nx-toolbar">
        <span class="nx-crumb">@Breadcrumb()</span>
    </div>

    <div class="nx-shell-body">
        @* Sol kısayol paneli. İçerik şimdilik sabit — gerçek kuyruk sayıları
           (outbox, e-fatura) ayrı bir servis bağlantısı gerektiriyor, sonraki
           adım olarak not düşüldü. *@
        <aside class="nx-rail">
            <div class="nx-rail-kicker">Kısayollar</div>
            @foreach (var item in RailShortcuts)
            {
                <a class="nx-rail-item @(CurrentPath == item.Href ? "active" : "")" href="@item.Href">
                    <span>@item.Title</span>
                </a>
            }

            <div class="nx-rail-kicker">Dönem</div>
            <div class="nx-rail-row">
                <span class="text-muted">@DateTime.Today.ToString("MMMM yyyy",
                    System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</span>
                <span class="tag tag-accent" style="font-size:9px;padding:1px 6px">AÇIK</span>
            </div>

            <div class="nx-rail-kicker">Kuyruklar</div>
            <div class="nx-rail-row">
                <span class="text-muted">Outbox</span>
                <a href="/sistem-testi" class="text-muted" style="text-decoration:none">bkz. sistem testi</a>
            </div>
        </aside>

        <main class="nx-content" style="flex:1;min-width:0;overflow:auto">
            @Body
        </main>
    </div>

    <div class="nx-statusbar">
        <span class="dot"></span>
        <span>Bağlı</span>
        <span class="sep">·</span>
        <span>@DateTime.Today.ToString("yyyy") dönemi</span>
        <span class="push">
            <AuthorizeView>
                <Authorized><span>@RoleOf(context)</span></Authorized>
            </AuthorizeView>
            <span class="sep">·</span>
            <span>Ctrl+K ile ara</span>
        </span>
    </div>
</div>

@code {
    private bool _isDark;
    private bool _themeLoaded;
    private bool _profileOpen;

    // ---------------- Arama ----------------

    private sealed record SearchItem(string Title, string Href, string Group);

    private static readonly SearchItem[] Pages =
    [
        new("Genel Bakış", "/", "Ana ekran"),
        new("Cari Kartlar", "/cariler", "Cari"),
        new("Cari Ekstre", "/cari-ekstre", "Cari"),
        new("Faturalar", "/faturalar", "Satış"),
        new("Yeni Fatura", "/faturalar/yeni", "Satış"),
        new("Alış Faturası Gir", "/faturalar/yeni?tip=alis", "Satış"),
        new("Ürün / Hizmet", "/urunler", "Satış"),
        new("Tahsilatlar", "/tahsilatlar", "Finans"),
        new("Yaşlandırma Raporu", "/yaslandirma", "Finans"),
        new("Planlar", "/planlar", "Abonelik"),
        new("Abonelikler", "/abonelikler", "Abonelik"),
        new("Hesap Planı", "/hesap-plani", "Muhasebe"),
        new("Muhasebe Fişleri", "/fisler", "Muhasebe"),
        new("Yeni Fiş", "/fisler/yeni", "Muhasebe"),
        new("Mizan", "/mizan", "Muhasebe"),
        new("Bilanço", "/bilanco", "Muhasebe"),
        new("Gelir Tablosu", "/gelir-tablosu", "Muhasebe"),
        new("Denetim Kaydı", "/denetim", "Sistem"),
        new("Kullanıcılar", "/kullanicilar", "Sistem"),
        new("Sistem Testi", "/sistem-testi", "Sistem"),
        new("Ayarlar", "/ayarlar", "Sistem"),
        new("Profilim", "/profil", "Hesap")
    ];

    // ---------------- Kabuk: kırıntı + sol panel ----------------

    private static readonly SearchItem[] RailShortcuts =
    [
        Pages[3],  // Faturalar
        Pages[7],  // Tahsilatlar
        Pages[10], // Abonelikler
        Pages[14], // Mizan
        Pages[17], // Denetim Kaydı
    ];

    private string CurrentPath => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');

    /// <summary>
    /// "GRUP › SAYFA" — arama için tutulan Pages listesinden türetiliyor, ayrı
    /// bir eşleme tablosu bakımı gerektirmesin diye. Eşleşme yoksa (örn. alt
    /// rotalar: /faturalar/{id}) en uzun ön ekle eşleşen sayfa kullanılır.
    /// </summary>
    private string Breadcrumb()
    {
        var path = CurrentPath;
        var match = Pages
            .Where(p => path == p.Href || (p.Href != "/" && path.StartsWith(p.Href, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(p => p.Href.Length)
            .FirstOrDefault();

        return match is null ? "NEXUSERP" : $"{match.Group.ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))} › {match.Title}";
    }

    private string _query = string.Empty;

    // ⚠️ Stil MARKUP'A yazılmaz: Razor ifadesi içindeki çift tırnaklar
    // attribute'ü erken kapatıp derleyiciyi ilgisiz hatalara sürüklüyor.
    // ⚠️ Üst bar KOYU zeminli; açılır liste oradan renk devraldığı için metin
    // okunmuyordu. Renkler açıkça sayfa gövdesinin tokenlarına sabitleniyor.
    // z-index modül menüsünün üstünde olmalı, yoksa menü listeyi kesiyor.
    private const string DropdownStyle =
        "position:absolute;top:34px;left:0;width:320px;z-index:9999;padding:4px;" +
        "background:var(--color-surface);color:var(--color-text);" +
        "box-shadow:0 8px 24px rgba(0,0,0,.28)";

    /// <summary>
    /// ⚠️ Türkçe karşılaştırma: "İ" ve "ı" harfleri InvariantCulture'da yanlış
    /// eşleşiyor ("İSTANBUL".Contains("ist") false döner). tr-TR ile ToUpper.
    /// </summary>
    private List<SearchItem> Matches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_query)) return [];
            var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
            var q = _query.Trim().ToUpper(tr);
            return [.. Pages
                .Where(p => p.Title.ToUpper(tr).Contains(q) || p.Group.ToUpper(tr).Contains(q))
                .Take(7)];
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _query = string.Empty; return; }
        if (e.Key != "Enter") return;

        var items = Matches;
        if (items.Count > 0) Go(items[0].Href);
    }

    private const string HotkeyScript =
        "if(!window.__nxSearchHotkey){window.__nxSearchHotkey=true;" +
        "document.addEventListener('keydown',function(e){" +
        "if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();" +
        "var el=document.getElementById('nx-global-search');if(el)el.focus();}});}";

    private void Go(string href)
    {
        _query = string.Empty;
        Nav.NavigateTo(href);
    }

    private const string TenantName = "Nexus Demo Yazılım A.Ş.";

    private static string PeriodLabel => $"DÖNEM {DateTime.Today.Year}";

    /// <summary>
    /// Sayfa değişince arama kutusu temizlenir. Aksi halde sonuca tıklayıp
    /// gidildikten sonra metin kutuda kalıyor ve açılır liste açık görünüyor.
    /// </summary>
    protected override void OnInitialized() =>
        Nav.LocationChanged += (_, _) =>
        {
            if (_query.Length == 0 && !_profileOpen) return;
            _query = string.Empty;
            _profileOpen = false;
            InvokeAsync(StateHasChanged);
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeLoaded) return;

        // Tercih localStorage'da; sayfa açılışında js/theme.js zaten uyguladı,
        // burada MudBlazor'ın kendi durumunu da eşitliyoruz.
        _themeLoaded = true;
        var mode = await JS.InvokeAsync<string>("nexusTheme.get");
        _isDark = mode == "dark";

        // Ctrl+K arama kutusunu odaklasın.
        // ⚠️ Raw string literal (üç tırnak) KULLANILMAZ: Razor bunu @code
        // içinde ayrıştıramıyor ve dosyanın tamamı derlenemez hale geliyor.
        await JS.InvokeVoidAsync("eval", HotkeyScript);

        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        // MudThemeProvider bileşen renklerini, data-theme özniteliği CSS
        // değişkenlerini döndürür — ikisi birlikte set edilmek zorunda.
        await JS.InvokeVoidAsync("nexusTheme.set", _isDark ? "dark" : "light");
    }

    private static string FullNameOf(AuthenticationState state) =>
        state.User.FindFirst("full_name")?.Value
        ?? state.User.Identity?.Name
        ?? "Kullanıcı";

    private static string RoleOf(AuthenticationState state) =>
        state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "—";

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..1].ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
        return string.Concat(parts[0][..1], parts[^1][..1])
                     .ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
    }

    /* Tasarım tokenlarıyla eşleşen MudTheme. Bileşen içi renkler buradan,
       sayfa düzeni CSS değişkenlerinden okunur (koyu tema tek yerden dönsün). */
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#5980a6",
            Secondary = "#5980a6",
            Background = "#f2f2f3",
            Surface = "#f2f2f3",
            AppbarBackground = "#1d2d3d",
            TextPrimary = "#1d1f20",
            Divider = "#1d1f2029",
            DrawerBackground = "#f2f2f3"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#94bce3",
            Secondary = "#94bce3",
            Background = "#1b1e21",
            Surface = "#25292d",
            AppbarBackground = "#1d2d3d",
            TextPrimary = "#e9eaeb"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "0" },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Barlow", "Segoe UI", "sans-serif"],
                FontSize = "13px"
            },
            H5 = new H5Typography { FontFamily = ["Barlow Condensed", "sans-serif"], FontWeight = "600" },
            H6 = new H6Typography { FontFamily = ["Barlow Condensed", "sans-serif"], FontWeight = "600" },
            Button = new ButtonTypography
            {
                FontFamily = ["Barlow Condensed", "sans-serif"],
                FontWeight = "600",
                TextTransform = "none"
            }
        }
    };
}
